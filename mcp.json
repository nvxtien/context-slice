{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "context-slice": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "cd /tmp && exec npx -y --package=context-slice@1.9.0 context-slice mcp"
      ],
      "env": {
        "CONTEXT_SLICE_ROOT": "${CLAUDE_PROJECT_DIR}"
      }
    }
  }
}
