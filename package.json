{
  "name": "context-slice",
  "version": "1.10.2",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nvxtien/context-slice.git"
  },
  "bugs": {
    "url": "https://github.com/nvxtien/context-slice/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/src",
    "queries",
    "skills",
    "hooks",
    "plugin.json",
    "mcp.json",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "context-slice": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "start": "node dist/src/server/mcp-server.js",
    "cli": "tsx src/cli.ts",
    "package-smoke": "tsx scripts/package-smoke-test.ts",
    "release:rc": "tsx scripts/clean-room-rc.ts",
    "test": "node scripts/run-tests.mjs",
    "benchmark:checkouts": "tsx benchmarks/fetch-checkouts.ts",
    "benchmark:v07": "tsx benchmarks/v0.7-developer-workflow.ts",
    "benchmark:v08": "npm run package-smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark:v15-phase3": "npm run benchmark:checkouts && tsx benchmarks/v1.5-rust-tasks.ts",
    "benchmark:v110-c-family": "npm run benchmark:checkouts && tsx benchmarks/v1.10-c-family-indexing.ts",
    "benchmark:v110-c-tasks": "npm run benchmark:checkouts && tsx benchmarks/v1.10-c-tasks.ts",
    "benchmark:v110-cpp-tasks": "npm run benchmark:checkouts && tsx benchmarks/v1.10-cpp-tasks.ts",
    "benchmark:v110-csharp-tasks": "npm run benchmark:checkouts && tsx benchmarks/v1.10-csharp-tasks.ts",
    "benchmark:v110-kotlin-tasks": "npm run benchmark:checkouts && tsx benchmarks/v1.10-kotlin-tasks.ts",
    "benchmark:v110-go-tasks": "npm run benchmark:checkouts && tsx benchmarks/v1.10-go-tasks.ts",
    "benchmark:v110-javascript-tasks": "npm run benchmark:checkouts && tsx benchmarks/v1.10-javascript-tasks.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "better-sqlite3": "^11.8.1",
    "tree-sitter": "^0.21.1",
    "tree-sitter-c": "0.23.2",
    "tree-sitter-c-sharp": "^0.21.3",
    "tree-sitter-cpp": "0.23.2",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-rust": "0.21.0",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.21",
    "prettier": "^3.9.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
