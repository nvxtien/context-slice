[
  {
    "id": "express-not-found-locate",
    "repository": "express-api-starter-ts",
    "category": "locate",
    "task": "Where is the 404 not found handler defined?",
    "targetSymbol": "notFound",
    "groundTruthFiles": ["src/middlewares.ts", "src/app.ts"],
    "groundTruth": "Manual source inspection at the pinned commit",
    "requiredFacts": [
      {
        "id": "status",
        "description": "The handler sets a 404 status code",
        "verification": {
          "type": "source-fragment",
          "patterns": ["res.status(404)"]
        }
      },
      {
        "id": "forward",
        "description": "It forwards an Error to the next middleware rather than responding itself",
        "verification": {
          "type": "source-fragment",
          "patterns": ["next(error)"]
        }
      },
      {
        "id": "url",
        "description": "The error message includes the requested URL",
        "verification": {
          "type": "source-fragment",
          "patterns": ["req.originalUrl"]
        }
      }
    ],
    "baselineFiles": ["src/middlewares.ts", "src/app.ts"]
  },
  {
    "id": "express-error-handler-explain",
    "repository": "express-api-starter-ts",
    "category": "explain",
    "task": "Explain how errors are turned into JSON responses.",
    "targetSymbol": "errorHandler",
    "groundTruthFiles": [
      "src/middlewares.ts",
      "src/interfaces/error-response.ts"
    ],
    "groundTruth": "Manual source inspection at the pinned commit",
    "requiredFacts": [
      {
        "id": "status",
        "description": "A non-200 status is preserved, otherwise the response falls back to 500",
        "verification": {
          "type": "source-fragment",
          "patterns": ["res.statusCode !== 200 ? res.statusCode : 500"]
        }
      },
      {
        "id": "body",
        "description": "The response body carries the error message",
        "verification": {
          "type": "source-fragment",
          "patterns": ["message: err.message"]
        }
      },
      {
        "id": "stack",
        "description": "The stack trace is hidden in production",
        "verification": {
          "type": "source-fragment",
          "patterns": ["env.NODE_ENV === \"production\""]
        }
      }
    ],
    "baselineFiles": ["src/middlewares.ts", "src/interfaces/error-response.ts"]
  },
