  {
    "id": "itsdangerous-unsign-locate",
    "repository": "itsdangerous",
    "category": "locate",
    "task": "Where is a signature verified when unsigning a value?",
    "targetSymbol": "Signer.unsign",
    "groundTruthFiles": ["src/itsdangerous/signer.py"],
    "groundTruth": "Manual source inspection at the pinned commit",
    "requiredFacts": [
      {
        "id": "separator",
        "description": "A missing separator is rejected",
        "verification": {
          "type": "source-fragment",
          "patterns": ["if self.sep not in signed_value:", "raise BadSignature"]
        }
      },
      {
        "id": "split",
        "description": "The value and signature are split on the last separator",
        "verification": {
          "type": "source-fragment",
          "patterns": ["value, sig = signed_value.rsplit(self.sep, 1)"]
        }
      },
      {
        "id": "verify",
        "description": "The signature is verified before the value is returned",
        "verification": {
          "type": "source-fragment",
          "patterns": ["if self.verify_signature(value, sig):"]
        }
      }
    ],
    "baselineFiles": ["src/itsdangerous/signer.py", "src/itsdangerous/exc.py"]
  },
