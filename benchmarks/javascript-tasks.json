[
  {
    "id": "express-app-handle",
    "repository": "express",
    "category": "explain",
    "task": "What does app.handle do before delegating to the router?",
    "targetSymbol": "handle",
    "groundTruthFiles": [
      "lib/application.js"
    ],
    "groundTruth": "Manual source inspection at the pinned commit",
    "requiredFacts": [
      {
        "id": "powered-by",
        "description": "sets the X-Powered-By header",
        "verification": {
          "type": "source-fragment",
          "patterns": [
            "res.setHeader('X-Powered-By', 'Express');"
          ]
        }
      },
      {
        "id": "delegate",
        "description": "hands the request to the router",
        "verification": {
          "type": "source-fragment",
          "patterns": [
            "this.router.handle(req, res, done);"
          ]
        }
      }
    ],
    "baselineFiles": [
      "lib/application.js"
    ]
  },
