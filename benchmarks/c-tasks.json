  {
    "id": "cjson-add-item-array",
    "repository": "cjson",
    "category": "explain",
    "task": "How does add_item_to_array append an item and what inputs does it reject?",
    "targetSymbol": "add_item_to_array",
    "groundTruthFiles": [
      "cJSON.c"
    ],
    "groundTruth": "Manual source inspection at the pinned commit",
    "requiredFacts": [
      {
        "id": "reject",
        "description": "null arguments and self-insertion are rejected",
        "verification": {
          "type": "source-fragment",
          "patterns": [
            "if ((item == NULL) || (array == NULL) || (array == item))"
          ]
        }
      },
      {
        "id": "append",
        "description": "a non-empty list is extended through suffix_object",
        "verification": {
          "type": "source-fragment",
          "patterns": [
            "suffix_object(child->prev, item);"
          ]
        }
      }
    ],
    "baselineFiles": [
      "cJSON.c"
    ]
  },
  {
    "id": "cjson-add-item-impact",
    "repository": "cjson",
    "category": "impact",
