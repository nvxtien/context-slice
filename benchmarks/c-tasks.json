          ]
        }
      },
      {
        "id": "object",
        "description": "add_item_to_object appends the item via it",
        "verification": {
          "type": "source-fragment",
          "patterns": [
            "return add_item_to_array(object, item);"
          ]
        }
      },
      {
        "id": "reference",
        "description": "adding a reference wraps the item first",
        "verification": {
          "type": "source-fragment",
          "patterns": [
