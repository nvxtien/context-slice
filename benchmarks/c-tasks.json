          ]
        }
      }
    ],
    "baselineFiles": [
      "cJSON.c"
    ]
  },
  {
    "id": "cjson-delete-recursion",
    "repository": "cjson",
    "category": "explain",
    "task": "How does cJSON_Delete free a tree, and what does it skip for reference items?",
    "targetSymbol": "cJSON_Delete",
    "groundTruthFiles": [
      "cJSON.c"
    ],
    "groundTruth": "Manual source inspection at the pinned commit",
    "requiredFacts": [
      {
        "id": "child",
        "description": "children are freed recursively unless the item is a reference",
        "verification": {
          "type": "source-fragment",
          "patterns": [
            "if (!(item->type & cJSON_IsReference) && (item->child != NULL))"
          ]
        }
      },
      {
        "id": "free",
        "description": "the item itself is released through the allocator hooks",
        "verification": {
          "type": "source-fragment",
          "patterns": [
            "global_hooks.deallocate(item);"
          ]
        }
      }
    ],
    "baselineFiles": [
      "cJSON.c"
    ]
  },
