[
  {
    "id": "mux-servehttp-redirect",
    "repository": "gorilla-mux",
    "category": "locate",
    "task": "Where does Router.ServeHTTP redirect a request whose path is not in canonical form?",
    "targetSymbol": "Router.ServeHTTP",
    "groundTruthFiles": [
      "mux.go"
    ],
    "groundTruth": "Manual source inspection at the pinned commit",
    "requiredFacts": [
      {
        "id": "redirect",
        "description": "non-canonical paths get a 301 response",
        "verification": {
          "type": "source-fragment",
          "patterns": [
            "w.WriteHeader(http.StatusMovedPermanently)"
          ]
        }
      }
    ],
    "baselineFiles": [
      "mux.go"
    ]
  },
  {
