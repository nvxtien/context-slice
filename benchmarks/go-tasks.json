  {
    "id": "mux-requestwithvars-impact",
    "repository": "gorilla-mux",
    "category": "impact",
    "task": "Which code is affected if requestWithVars changes?",
    "targetSymbol": "requestWithVars",
    "groundTruthFiles": [
      "mux.go",
      "test_helpers.go"
    ],
    "groundTruth": "Manual source inspection at the pinned commit",
    "requiredFacts": [
      {
        "id": "definition",
        "description": "requestWithVars is a package-private helper",
        "verification": {
          "type": "source-fragment",
          "patterns": [
            "func requestWithVars(r *http.Request, vars map[string]string) *http.Request {"
          ]
        }
      },
      {
        "id": "servehttp",
        "description": "Router.ServeHTTP calls it when the route is omitted from context",
        "verification": {
          "type": "source-fragment",
          "patterns": [
            "req = requestWithVars(req, match.Vars)"
          ]
        }
      },
      {
        "id": "helper",
        "description": "the SetURLVars test helper calls it",
        "verification": {
          "type": "source-fragment",
          "patterns": [
            "return requestWithVars(r, val)"
          ]
        }
      }
    ],
    "baselineFiles": [
      "mux.go",
      "test_helpers.go"
    ]
  },
